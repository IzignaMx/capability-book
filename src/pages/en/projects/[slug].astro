---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ProjectCaseStudyHero from "../../../components/projects/ProjectCaseStudyHero.astro";
import ProjectEvidenceFigure from "../../../components/projects/ProjectEvidenceFigure.astro";
import ProofPoint from "../../../components/projects/ProofPoint.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

interface Props {
  project: CollectionEntry<"projects">;
  slug: string;
}

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.locale === "en");
  return projects.map((project) => {
    const prefix = "en/";
    if (!project.id.startsWith(prefix)) {
      throw new Error(`Expected an English project entry, received: ${project.id}`);
    }

    const slug = project.id.slice(prefix.length);
    if (!slug || slug.includes("/")) {
      throw new Error(`Cannot derive a single-segment project slug from: ${project.id}`);
    }

    return { params: { slug }, props: { project, slug } };
  });
}

const { project, slug } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const site = Astro.site;

if (!site) throw new Error("Project detail routes require Astro.site.");

const canonicalPath = `/en/projects/${slug}/`;
const alternatePath = `/es/proyectos/${slug}/`;
const diagnosticHref = `/en/diagnostic/?project=${encodeURIComponent(slug)}&service=${encodeURIComponent(data.ctaPreset)}`;
const classificationLabels = {
  real: "Real project",
  "open-source": "Open source",
  internal: "Internal system",
  concept: "Concept"
} as const;
const confidentialityLabels = {
  public: "Public evidence",
  partial: "Partial disclosure",
  private: "Limited disclosure"
} as const;
const sameAs = [data.liveUrl, data.sourceUrl].filter((url): url is string => Boolean(url));
const structuredImage = data.visualEvidence.at(0)?.path ?? data.fallbackPoster;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: data.title,
  description: data.elevatorPitch,
  inLanguage: "en",
  url: new URL(canonicalPath, site).toString(),
  image: new URL(structuredImage, site).toString(),
  creator: { "@type": "Organization", name: "IzignaMx", url: site.toString() },
  genre: classificationLabels[data.classification],
  keywords: [...data.capabilities, ...data.technologies].join(", "),
  ...(sameAs.length ? { sameAs } : {})
};
---

<BaseLayout
  locale="en"
  title={`${data.title} — Case study | IzignaMx`}
  description={data.elevatorPitch}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  mode="evaluate"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article class="case-study" data-pagefind-body>
    <ProjectCaseStudyHero
      slug={slug}
      title={data.title}
      claim={data.elevatorPitch}
      openingLabel={`${classificationLabels[data.classification]} · ${confidentialityLabels[data.confidentiality]}`}
      fallbackPoster={data.fallbackPoster}
      evidence={data.visualEvidence.at(0)}
      locale="en"
    />

    <div class="case-study__solution" aria-labelledby="solution-title">
      <p>The system</p>
      <h2 id="solution-title">Solution</h2>
      <p>{data.solution}</p>
    </div>

    {data.visualEvidence.map((evidence) => (
      <ProjectEvidenceFigure evidence={evidence} locale="en" />
    ))}

    <div class="case-study__narrative">
      <Content />
    </div>

    <section class="case-study__evidence" aria-labelledby="evidence-title">
      <header>
        <p>Evidence ledger</p>
        <h2 id="evidence-title">Outcomes with explicit classification</h2>
      </header>
      <div class="case-study__proof-grid">
        {data.outcomes.map((point) => <ProofPoint point={point} locale="en" />)}
      </div>
    </section>

    <section class="case-study__services" aria-labelledby="services-title">
      <div>
        <p>Transferable capability</p>
        <h2 id="services-title">Related services</h2>
      </div>
      <ul>
        {data.relatedServices.map((service) => <li>{service}</li>)}
      </ul>
    </section>

    <aside class="case-study__cta" aria-labelledby="cta-title">
      <p>Next step</p>
      <h2 id="cta-title">Do you need a system with similar capabilities?</h2>
      <a href={diagnosticHref}>Request a diagnostic for {data.title}</a>
    </aside>
  </article>
</BaseLayout>

<style>
  .case-study {
    width: min(calc(100% - 2rem), var(--content-width));
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 6rem) 0 6rem;
  }

  .case-study__solution > p:first-child,
  .case-study__evidence header p,
  .case-study__services > div > p,
  .case-study__cta > p {
    margin: 0;
    color: var(--color-cyan);
    font: 700 0.72rem/1.2 var(--font-data);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .case-study__solution {
    display: grid;
    grid-template-columns: minmax(8rem, 0.35fr) minmax(10rem, 0.65fr) minmax(18rem, 1fr);
    gap: 1.5rem;
    margin: clamp(5rem, 10vw, 9rem) 0;
    padding: 2rem 0;
    border-block: 1px solid var(--color-line);
  }

  .case-study__solution h2,
  .case-study__solution > p:last-child,
  .case-study__evidence h2,
  .case-study__services h2,
  .case-study__cta h2 {
    margin: 0;
  }

  .case-study__solution h2,
  .case-study__evidence h2,
  .case-study__services h2,
  .case-study__cta h2 {
    font: 650 clamp(2rem, 5vw, 4rem)/0.95 var(--font-display);
    letter-spacing: -0.045em;
  }

  .case-study__solution > p:last-child {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .case-study__narrative {
    max-width: 56rem;
    margin-inline: auto;
  }

  .case-study__narrative :global(h2) {
    margin: 5rem 0 1.25rem;
    font: 650 clamp(2rem, 5vw, 3.75rem)/1 var(--font-display);
    letter-spacing: -0.04em;
  }

  .case-study__narrative :global(p),
  .case-study__narrative :global(li) {
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .case-study__narrative :global(a) {
    color: var(--color-brand-bright);
  }

  .case-study__evidence,
  .case-study__services,
  .case-study__cta {
    margin-top: clamp(5rem, 10vw, 9rem);
  }

  .case-study__evidence > header {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
    margin-bottom: 2rem;
  }

  .case-study__proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    padding: 1px;
    background: var(--color-line);
  }

  .case-study__services {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 1fr);
    gap: 2rem;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--color-line);
  }

  .case-study__services > div {
    display: grid;
    gap: 1rem;
  }

  .case-study__services ul {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__services li {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text-muted);
  }

  .case-study__cta {
    display: grid;
    gap: 1.5rem;
    padding: clamp(2rem, 7vw, 6rem);
    background:
      radial-gradient(circle at 85% 20%, rgb(34 211 238 / 20%), transparent 24rem),
      var(--color-midnight);
  }

  .case-study__cta h2 {
    max-width: 18ch;
  }

  .case-study__cta a {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    min-height: 44px;
    padding: var(--control-padding-block) var(--control-padding-inline);
    border-radius: var(--radius-pill);
    background: var(--color-brand);
    color: var(--color-space);
    font-weight: 750;
    text-decoration: none;
    transition: background-color var(--motion-fast);
  }

  .case-study__cta a:hover {
    background: var(--color-brand-bright);
  }

  .case-study__cta a:active {
    transform: translateY(1px);
  }

  @media (max-width: 52rem) {
    .case-study__solution,
    .case-study__services {
      grid-template-columns: 1fr;
    }

    .case-study__proof-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
