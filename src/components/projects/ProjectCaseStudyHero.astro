---
import type { Locale, ProjectVisualEvidence } from "../../domain/projects/PortfolioProject";

interface Props {
  title: string;
  claim: string;
  openingLabel: string;
  fallbackPoster: string;
  evidence: ProjectVisualEvidence | undefined;
  locale: Locale;
}

const { title, claim, openingLabel, fallbackPoster, evidence, locale } = Astro.props;
const isLocalCapture = evidence?.provenance.kind === "local-development-capture";
const labels = locale === "es"
  ? {
      evidence: "Portada de producción · evidencia completa más abajo",
      local: "Portada de captura local autorizada · evidencia completa más abajo",
      fallback: "Portada ilustrativa · sin captura pública autorizada",
      fallbackAlt: `Visual ilustrativo de apertura del proyecto ${title}`
    }
  : {
      evidence: "Production cover · complete evidence below",
      local: "Authorized local-capture cover · complete evidence below",
      fallback: "Illustrative cover · no authorized public capture",
      fallbackAlt: `Illustrative opening visual for the ${title} project`
    };
---

<header class="project-hero">
  <div class="project-hero__opening">
    <p class="project-hero__classification case-study__classification">{openingLabel}</p>
    <h1>{title}</h1>
    <p class="project-hero__claim">{claim}</p>
  </div>

  <figure
    class="project-hero__media"
    data-project-cover
    data-cover-kind={evidence ? isLocalCapture ? "local" : "production" : "illustrative"}
  >
    <div class="project-hero__frame">
      {evidence ? (
        <picture>
          <source
            media="(max-width: 40rem)"
            srcset={evidence.variants.mobile.avif}
            type="image/avif"
            width={evidence.variants.mobile.width}
            height={evidence.variants.mobile.height}
          />
          <source
            media="(max-width: 40rem)"
            srcset={evidence.variants.mobile.webp}
            type="image/webp"
            width={evidence.variants.mobile.width}
            height={evidence.variants.mobile.height}
          />
          <source
            srcset={evidence.variants.desktop.avif}
            type="image/avif"
            width={evidence.variants.desktop.width}
            height={evidence.variants.desktop.height}
          />
          <img
            src={evidence.variants.desktop.webp}
            alt={evidence.alt}
            width={evidence.variants.desktop.width}
            height={evidence.variants.desktop.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      ) : (
        <img
          src={fallbackPoster}
          alt={labels.fallbackAlt}
          width="1280"
          height="720"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )}
    </div>
    <figcaption>{evidence ? isLocalCapture ? labels.local : labels.evidence : labels.fallback}</figcaption>
  </figure>
</header>

<style>
  .project-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: end;
    gap: clamp(2rem, 4vw, 4.5rem);
    min-height: min(44rem, 76vh);
  }

  .project-hero__opening,
  .project-hero__media {
    min-width: 0;
  }

  .project-hero__opening {
    display: grid;
    gap: 1.25rem;
  }

  .project-hero__classification {
    margin: 0;
    color: var(--color-cyan);
    font: 700 0.72rem/1.2 var(--font-data);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    font: 650 clamp(3.25rem, 5.4vw, 7rem)/0.92 var(--font-display);
    letter-spacing: -0.05em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .project-hero__claim {
    max-width: 36rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(1.1rem, 1.7vw, 1.4rem);
    overflow-wrap: anywhere;
  }

  .project-hero__media {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .project-hero__frame {
    aspect-ratio: 8 / 5;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-midnight);
  }

  .project-hero__frame picture,
  .project-hero__frame img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .project-hero__frame img {
    object-fit: cover;
    object-position: top center;
  }

  .project-hero__media figcaption {
    margin: 0;
    color: var(--color-text-muted);
    font: 600 0.7rem/1.4 var(--font-data);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 64rem) {
    .project-hero {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      min-height: 0;
    }

    h1 {
      max-width: 14ch;
      font-size: clamp(3rem, 9vw, 5.75rem);
    }
  }

  @media (max-width: 40rem) {
    h1 {
      font-size: clamp(2.75rem, 12vw, 4.5rem);
      line-height: 0.96;
      letter-spacing: -0.045em;
    }
  }
</style>
